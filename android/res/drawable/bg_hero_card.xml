<?xml version="1.0" encoding="utf-8"?>
<!-- Hero/gradient card. angle=315 == CSS linear-gradient(135deg) i.e. top-left -> bottom-right. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/hero_start"
        android:centerColor="@color/hero_mid"
        android:endColor="@color/hero_end"
        android:type="linear" />
    <corners android:radius="@dimen/r_lg" />
</shape>

