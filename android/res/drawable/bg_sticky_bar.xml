<?xml version="1.0" encoding="utf-8"?>
<!-- Sticky bottom action bar: paper with a hairline top edge, so it separates
     from scrolling content without a heavy shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/line" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
        </shape>
    </item>
</layer-list>
