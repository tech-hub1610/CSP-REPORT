<?xml version="1.0" encoding="utf-8"?>
<!-- Web progress bar runs primary-600 to ok. Blue to green reads as
     "progress toward done" and is the app's primary completion affordance. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/primary_600"
        android:endColor="@color/ok"
        android:type="linear" />
    <corners android:radius="@dimen/progress_h" />
</shape>
