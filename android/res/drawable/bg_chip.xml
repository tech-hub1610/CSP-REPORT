<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_dark">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/primary_600" />
                    <corners android:radius="@dimen/r_pill" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/paper" />
                    <corners android:radius="@dimen/r_pill" />
                    <stroke android:width="1dp" android:color="@color/line_2" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
