<?xml version="1.0" encoding="utf-8"?>
<!-- Input field: neutral border, turns primary + gains a halo when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <corners android:radius="@dimen/r_sm" />
            <stroke android:width="2dp" android:color="@color/primary_600" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <corners android:radius="@dimen/r_sm" />
            <stroke android:width="2dp" android:color="@color/primary_500" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/fill" />
            <corners android:radius="@dimen/r_sm" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <corners android:radius="@dimen/r_sm" />
            <stroke android:width="1dp" android:color="@color/line_2" />
        </shape>
    </item>
</selector>

