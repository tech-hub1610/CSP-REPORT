<?xml version="1.0" encoding="utf-8"?>
<!--
  Exit half of the splash handoff. fade_in.xml already existed with no consumer;
  this is its pair, so SplashActivity -> MainActivity cross-fades instead of
  inheriting the activity slide used for in-app navigation.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="260"
    android:fromAlpha="1.0"
    android:interpolator="@android:anim/accelerate_interpolator"
    android:toAlpha="0.0" />
