<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================== Application theme ========================
         Framework Material (no AndroidX). colourPrimary drives the app bar,
         colourAccent drives widgets (edit-text underline, checkbox, progress). -->
    <style name="Theme.Csp" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary_900</item>
        <item name="android:colorPrimaryDark">@color/navy_950</item>
        <item name="android:colorAccent">@color/primary_600</item>
        <item name="android:colorBackground">@color/bg_app</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:statusBarColor">@color/navy_950</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_3</item>
        <item name="android:textColorHint">@color/ink_4</item>
        <item name="android:windowAnimationStyle">@style/Anim.Activity</item>
    </style>

    <style name="Anim.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Animation.Sheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!-- Sheets and dialogs -->
    <style name="Theme.Csp.Sheet" parent="@android:style/Theme.Material.Light.Dialog">
        <item name="android:colorAccent">@color/primary_600</item>
        <item name="android:windowBackground">@drawable/bg_sheet</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <style name="Theme.Csp.Translucent" parent="Theme.Csp">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/scrim</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!--
      Splash. The window background is the gradient itself, so the frame the
      system paints before any of our code runs is already on-brand; the bars are
      held at the darkest navy so the image does not sit against a light edge.
    -->
    <style name="Theme.Csp.Splash" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:colorPrimary">@color/navy_950</item>
        <item name="android:statusBarColor">@color/navy_950</item>
        <item name="android:navigationBarColor">@color/navy_950</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Text appearances -->
    <style name="Text" />

    <style name="Text.Display">
        <item name="android:textSize">@dimen/t_display</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Text.Metric">
        <item name="android:textSize">@dimen/t_metric</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Text.MetricSm">
        <item name="android:textSize">@dimen/t_metric_sm</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Text.ScreenTitle">
        <item name="android:textSize">@dimen/t_screen_title</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.CardTitle">
        <item name="android:textSize">@dimen/t_card_title</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/t_body</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <style name="Text.Label">
        <item name="android:textSize">@dimen/t_label</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Meta">
        <item name="android:textSize">@dimen/t_meta</item>
        <item name="android:textColor">@color/ink_3</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Nano">
        <item name="android:textSize">@dimen/t_nano</item>
        <item name="android:textColor">@color/ink_4</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Uppercase eyebrow used for section headers and KPI captions. -->
    <style name="Text.Section">
        <item name="android:textSize">@dimen/t_micro</item>
        <item name="android:textColor">@color/ink_3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.KpiCaption">
        <item name="android:textSize">@dimen/t_micro</item>
        <item name="android:textColor">@color/ink_3</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Status pill text: never relies on colour alone — always carries a word. -->
    <style name="Text.Badge">
        <item name="android:textSize">@dimen/t_micro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- On-hero variants -->
    <style name="Text.HeroLabel">
        <item name="android:textSize">@dimen/t_micro</item>
        <item name="android:textColor">@color/hero_text_dim</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===================== Components =============================== -->
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/sp_4</item>
        <item name="android:elevation">@dimen/el_1</item>
    </style>

    <style name="Card.Flush">
        <item name="android:padding">0dp</item>
    </style>

    <style name="Hr">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line</item>
    </style>

    <!-- Primary CTA: full width, 48dp, rounded, ripple -->
    <style name="Btn" parent="@android:style/Widget.Material.Light.Button">
        <item name="android:textSize">@dimen/t_card_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:minHeight">@dimen/h_button</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">@dimen/sp_5</item>
        <item name="android:paddingRight">@dimen/sp_5</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Btn.Tonal">
        <item name="android:textColor">@color/primary_700</item>
        <item name="android:background">@drawable/bg_btn_tonal</item>
    </style>

    <style name="Btn.Outline">
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:background">@drawable/bg_btn_outline</item>
    </style>

    <style name="Btn.Danger">
        <item name="android:textColor">@color/paper</item>
        <item name="android:background">@drawable/bg_btn_danger</item>
    </style>

    <style name="Btn.Sm">
        <item name="android:minHeight">@dimen/h_button_sm</item>
        <item name="android:textSize">@dimen/t_label</item>
        <item name="android:paddingLeft">@dimen/sp_3</item>
        <item name="android:paddingRight">@dimen/sp_3</item>
    </style>

    <!-- Icon-only round action inside a list row (call / whatsapp / report) -->
    <style name="IconBtn">
        <item name="android:layout_width">@dimen/ic_tile</item>
        <item name="android:layout_height">@dimen/ic_tile</item>
        <item name="android:padding">@dimen/sp_2</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Numeric report input -->
    <style name="NumField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/h_input</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:inputType">number</item>
        <item name="android:digits">0123456789</item>
        <item name="android:maxLength">5</item>
        <item name="android:textSize">@dimen/t_metric_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">@dimen/sp_2</item>
        <item name="android:paddingRight">@dimen/sp_2</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/h_input</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingLeft">@dimen/sp_3</item>
        <item name="android:paddingRight">@dimen/sp_3</item>
        <item name="android:paddingTop">@dimen/sp_2</item>
        <item name="android:paddingBottom">@dimen/sp_2</item>
        <item name="android:textSize">@dimen/t_body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:gravity">top|start</item>
    </style>

    <style name="FilterChip">
        <item name="android:layout_height">@dimen/h_chip</item>
        <item name="android:paddingLeft">@dimen/sp_3</item>
        <item name="android:paddingRight">@dimen/sp_3</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textSize">@dimen/t_meta</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
    </style>

</resources>
